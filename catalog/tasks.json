[
  {
    "taskSchemaVersion": 1,
    "recipeVersion": 1,
    "taskId": "inbox.brief",
    "title": "本人流程工作简报",
    "description": "按来源和类别整理有界清单，保留完整性与真实时间",
    "tags": [
      "待办",
      "整理待办",
      "抄送",
      "已办",
      "流程消息"
    ],
    "provider": "personal",
    "systemId": null,
    "effect": "read",
    "operationId": "iam.workflow.list",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "todo",
              "done",
              "cc"
            ]
          }
        },
        "applicationId": {
          "type": "string",
          "pattern": "^[0-9]{1,10}$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "formType": {
          "type": "string",
          "maxLength": 100
        },
        "startedFrom": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "startedTo": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "requiredOutputFields": []
  },
  {
    "taskSchemaVersion": 1,
    "recipeVersion": 1,
    "taskId": "order-config.compare",
    "title": "门店订货配置比较",
    "description": "比较选定门店的真实配置值，缺记录保持未知",
    "tags": [
      "门店配置",
      "订货",
      "品项配置",
      "配置比较"
    ],
    "provider": "governed",
    "systemId": "supply-chain-server",
    "effect": "read",
    "operationId": "supply-chain-server.order-config.batch.read",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locatedPartitionId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "itemCode": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
        },
        "itemName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF][^\\u0000-\\u001F\\u007F-\\u009F]*$"
        },
        "shopCodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[\\p{L}\\p{N}_-]{1,32}$"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "itemCode"
          ]
        },
        {
          "required": [
            "itemName"
          ]
        }
      ],
      "required": [
        "shopCodes"
      ]
    },
    "requiredOutputFields": [
      "shopCode",
      "itemCode",
      "orderUnit",
      "minOrderNum",
      "maxOrderNum",
      "orderNumMultiplier",
      "enable",
      "orderable"
    ]
  },
  {
    "taskSchemaVersion": 1,
    "recipeVersion": 1,
    "taskId": "like.send",
    "title": "按明确指令发出点赞",
    "description": "绑定本次完整参数和合同，结果未知时只查询原意图",
    "tags": [
      "点赞",
      "发点赞",
      "表扬"
    ],
    "provider": "governed",
    "systemId": "hrmp",
    "effect": "write",
    "operationId": "hrmp.like.send",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beLikedPersonId",
        "likeTypeId",
        "likeTypeName",
        "likeBehaviorContent",
        "specificDeeds"
      ],
      "properties": {
        "beLikedPersonId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,17}$"
        },
        "likeTypeId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,17}$"
        },
        "likeTypeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF][^\\u0000-\\u001F\\u007F-\\u009F]*$"
        },
        "likeBehaviorContent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF][^\\u0000-\\u001F\\u007F-\\u009F]*$"
        },
        "specificDeeds": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF][^\\u0000-\\u001F\\u007F-\\u009F]*$"
        }
      }
    },
    "requiredOutputFields": [
      "intentId",
      "state",
      "sideEffect"
    ]
  }
]
